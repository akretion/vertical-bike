<odoo>
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_open_link_bicycode"
                    type="object"
                    string="Link Bicycodes"
                    class="btn-secondary"
                />
            </header>
            <field name="partner_id" position="after">
                <field
                    name="bicycode_ids"
                    widget="many2many_tags"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="customer_bicycode" />
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_bicycodes"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bicycle"
                >
                    <field string="Bicycodes" name="bicycode_count" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
