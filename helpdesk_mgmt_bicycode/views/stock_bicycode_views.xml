<odoo>
    <record id="view_bicycode_form" model="ir.ui.view">
        <field name="model">stock.bicycode</field>
        <field name="inherit_id" ref="bicycode.view_bicycode_form" />
        <field name="arch" type="xml">
            <field name="picking_ids" position="after">
                <label for="ticket_ids" />
                <field name="ticket_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
